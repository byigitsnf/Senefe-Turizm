# Bu dosyayı .env adıyla kopyalayıp kendi anahtarlarınızı yazın. .env depoya girmez.
# Anahtar olmayan özellik kapalı kalır; site yine de açılır.

# Oteller: https://docs.liteapi.travel (sandbox anahtarı sand_ ile başlar)
LITEAPI_KEY=

# Rota haritası: AWS konsolu → Amazon Location Service → API keys
# Harita anahtarı izni: geo-maps:GetTile
AWS_LOCATION_MAP_KEY=
# Rota anahtarı izni: geo-routes:CalculateRoutes
AWS_LOCATION_ROUTE_KEY=
# Anahtarların bölgesi (isteğe bağlı, varsayılan eu-north-1)
AWS_LOCATION_REGION=

# Anlık uçuş takibi (isteğe bağlı): opensky-network.org → Account → API client
# Boş kalırsa hesapsız, IP başına düşük kotayla çalışır.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Veritabanı (isteğe bağlı): boş kalırsa turlar api/seed/catalog.json dosyasından gelir
COSMOS_CONNECTION_STRING=
